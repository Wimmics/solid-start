@prefix idx: <https://ns.inria.fr/idx/terms#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix dc: <http://purl.org/dc/terms/>.
@prefix sh: <https://www.w3.org/ns/shacl#>.
@prefix vann: <http://purl.org/vocab/vann/>.

<https://ns.inria.fr/idx/terms>
    a owl:Ontology ;
    dc:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    rdfs:label "Shape-based Indexing Ontology"@en ;
    rdfs:comment "The Shape-based Indexing vocabulary defines terms used to index data."@en ;
    rdfs:isDefinedBy <https://ns.inria.fr/idx/terms#> ;
    dc:issued "2024-06-21"^^xsd:date ;
    vann:preferredNamespacePrefix "idx" ;
    vann:preferredNamespaceUri "https://ns.inria.fr/idx/terms#"^^xsd:anyURI .

idx:Index
    a rdfs:Class ;
    dc:issued "2024-06-21"^^xsd:date ;
    rdfs:comment "A RDF document representing an index."@en ;
    rdfs:isDefinedBy <https://ns.inria.fr/idx/terms#> ;
    rdfs:label "index"@en .

idx:IndexEntry
    a rdfs:Class ;
    dc:issued "2024-06-21"^^xsd:date ;
    rdfs:comment "An entry in the index locating data matching a given shape."@en ;
    rdfs:isDefinedBy <https://ns.inria.fr/idx/terms#> ;
    rdfs:label "index entry"@en .

idx:hasTarget
    a rdf:Property, owl:ObjectProperty, owl:FunctionalProperty ;
    dc:issued "2024-06-21"^^xsd:date ;
    rdfs:comment "A resource matching the shape of the subject entry."@en ;
    rdfs:isDefinedBy <https://ns.inria.fr/idx/terms#> ;
    rdfs:domain idx:IndexEntry, [
        rdfs:comment "hasTarget and hasSubIndex are exclusive" ;
        a owl:Restriction ;
        owl:onProperty idx:hasSubIndex ;
        owl:allValuesFrom owl:Nothing;
    ] ;
    rdfs:label "has target"@en.

idx:hasShape
    a rdf:Property, owl:ObjectProperty ;
    dc:issued "2024-06-21"^^xsd:date ;
    rdfs:comment "The shape that is matched by resources referred to by this entry."@en ;
    rdfs:isDefinedBy <https://ns.inria.fr/idx/terms#> ;
    rdfs:label "has shape"@en ;
    rdfs:domain idx:IndexEntry ;
    rdfs:range sh:NodeShape .

idx:hasCount
    a rdf:Property, owl:ObjectProperty, owl:FunctionalProperty ;
    dc:issued "2024-06-21"^^xsd:date ;
    rdfs:comment "The number of resources that are referred to by the sub-index(es)."@en ;
    rdfs:seeAlso idx:hasSubIndex ;
    rdfs:isDefinedBy <https://ns.inria.fr/idx/terms#> ;
    rdfs:label "has count"@en ;
    rdfs:domain idx:IndexEntry, [
        rdfs:comment "hasCount implies hasSubIndex" ;
        a owl:Restriction ;
        owl:onProperty idx:hasSubIndex ;
        owl:someValuesFrom owl:Thing ;
    ] ;
    rdfs:range xsd:integer .

idx:hasSubIndex
    a rdf:Property, owl:ObjectProperty, owl:FunctionalProperty ;
    dc:issued "2024-06-21"^^xsd:date ;
    rdfs:comment "Another index referring to resources matching the shape of this entry."@en ;
    rdfs:isDefinedBy <https://ns.inria.fr/idx/terms#> ;
    rdfs:label "has sub index"@en ;
    rdfs:domain idx:IndexEntry, [
        rdfs:comment "hasTarget and hasSubIndex are exclusive" ;
        a owl:Restriction ;
        owl:onProperty idx:hasShape ;
        owl:allValuesFrom owl:Nothing ;
    ] ;
    rdfs:range idx:Index .
